@model e360_clone_fe.Models.ViewModels.StudentAttendancePageViewModel
@{
    ViewData["Title"] = "Attendance";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="main-content__wrapper">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24 px-24 pt-30">
        <div>
            <span class="fw-semibold mb-4 h6 text-primary-light d-block">Ký giấy ra phòng</span>
            <div>
                <a href="/" class="text-secondary-light hover-text-primary hover-underline">Dashboard</a>
                <span class="text-secondary-light">/ Exam / Ký giấy</span>
            </div>
        </div>
    </div>

    <div class="content-area p-24">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mb-16" role="alert">
                <i class="ri-check-line"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mb-16" role="alert">
                <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="card radius-12 mb-24">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-medium">Chọn ngày</label>
                        <input type="date" name="date" class="form-control" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary-600 w-100">
                            <i class="ri-search-line"></i> Xem lịch
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="card h-100">
            <div class="card-header border-bottom bg-base py-16 px-24">
                <h6 class="text-lg fw-semibold mb-0">Các ca thi trong ngày</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table bordered-table mb-0">
                        <thead class="bg-neutral-100">
                            <tr>
                                <th>Ca thi</th>
                                <th>Môn</th>
                                <th>Lớp</th>
                                <th>Phòng</th>
                                <th>Trạng thái</th>
                                <th>Ký giấy ra phòng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                foreach (var item in Model.Items)
                                {
                                    var statusLabel = item.StudentConfirmed ? "Đã ký giấy" : "Chưa ký giấy";
                                    var statusClass = item.StudentConfirmed ? "bg-success-100 text-success-600" : "bg-warning-100 text-warning-600";
                                    var canSign = string.Equals(item.Status, "Present", StringComparison.OrdinalIgnoreCase)
                                        || string.Equals(item.Status, "Late", StringComparison.OrdinalIgnoreCase);
                                    <tr data-attendance-id="@item.AttendanceId">
                                        <td>@item.StartTime.ToString("hh\\:mm") - @item.EndTime.ToString("hh\\:mm")</td>
                                        <td>@item.SubjectCode - @item.SubjectName</td>
                                        <td>@item.ClassCode</td>
                                        <td>@item.RoomCode</td>
                                        <td>
                                            <span class="px-10 py-2 radius-4 text-xs fw-semibold @statusClass js-status-label">
                                                @statusLabel
                                            </span>
                                        </td>
                                        <td>
                                            @if (canSign)
                                            {
                                                <form asp-controller="Attendance" asp-action="StudentConfirm" method="post" class="student-confirm-form">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="attendanceId" value="@item.AttendanceId" />
                                                    <input type="hidden" name="examId" value="@item.ExamId" />
                                                    <input type="hidden" name="status" value="@item.Status" />
                                                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                    <input type="hidden" name="confirmed" value="false" />
                                                    <label class="form-check d-inline-flex align-items-center gap-8 text-sm mb-0">
                                                        <input type="checkbox" name="confirmed" value="true" class="form-check-input js-confirm-checkbox" @(item.StudentConfirmed ? "checked disabled" : "") />
                                                        <span>Ký giấy</span>
                                                    </label>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-secondary-light">Không thể ký (trạng thái @item.Status)</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-secondary-light py-16">
                                        Không có ca thi trong ngày đã chọn.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.student-confirm-form').forEach(form => {
            const cb = form.querySelector('.js-confirm-checkbox');
            if (!cb) return;
            cb.addEventListener('change', async () => {
                const row = form.closest('tr');
                const statusLabel = row?.querySelector('.js-status-label');
                const fd = new FormData(form);
                fd.set('confirmed', cb.checked ? 'true' : 'false');
                try {
                    cb.disabled = true;
                    const res = await fetch(form.action, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    const data = await res.json();
                    if (!data?.success) {
                        cb.checked = !cb.checked;
                        return;
                    }
                    if (statusLabel) {
                        if (data.confirmed) {
                            statusLabel.textContent = 'Đã ký giấy';
                            statusLabel.classList.remove('bg-warning-100', 'text-warning-600');
                            statusLabel.classList.add('bg-success-100', 'text-success-600');
                        } else {
                            statusLabel.textContent = 'Chưa ký giấy';
                            statusLabel.classList.remove('bg-success-100', 'text-success-600');
                            statusLabel.classList.add('bg-warning-100', 'text-warning-600');
                        }
                    }
                } catch (e) {
                    cb.checked = !cb.checked;
                } finally {
                    cb.disabled = false;
                }
            });
        });
    </script>
}
