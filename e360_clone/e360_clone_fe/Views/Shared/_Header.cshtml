<div class="navbar-header shadow-1">
  <div class="row align-items-center justify-content-between">
    <div class="col-auto">
      <div class="d-flex flex-wrap align-items-center gap-4">
        <!-- Sidebar Mobile Toggle -->
        <button type="button" class="sidebar-mobile-toggle" aria-label="Sidebar Mobile Toggler Button">
          <iconify-icon icon="heroicons:bars-3-solid" class="icon"></iconify-icon>
        </button>
        
        <!-- Search Box -->
        <form class="navbar-search">
          <input type="text" class="bg-transparent" name="search" placeholder="Tìm kiếm...">
          <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
        </form>
      </div>
    </div>
    
    <div class="col-auto">
      <div class="d-flex flex-wrap align-items-center gap-3">
        <!-- Theme Toggle -->
        <button type="button" data-theme-toggle
          class="w-40-px h-40-px bg-neutral-200 rounded-circle d-flex justify-content-center align-items-center" 
          aria-label="Chế độ sáng tối">
          <iconify-icon icon="ri:sun-line" class="theme-icon-light"></iconify-icon>
          <iconify-icon icon="ri:moon-line" class="theme-icon-dark" style="display: none;"></iconify-icon>
        </button>
                
        <!-- User Profile -->
        <div class="dropdown">
          @{
              var avatarUrl = Context.Session.GetString("AvatarUrl");
              var avatarSrc = !string.IsNullOrWhiteSpace(avatarUrl)
                  ? avatarUrl
                  : "/assets/images/thumbs/avatar-img1.png";
          }
          <button type="button" data-bs-toggle="dropdown" aria-label="User Menu">
            <img src="@avatarSrc" alt="User"
              class="w-40-px h-40-px rounded-circle object-fit-cover">
          </button>
          <ul class="dropdown-menu dropdown-menu-lg-end border p-12">
            <li>
              <a href="/Profile"
                class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6">
                <i class="ri-user-3-line"></i>
                Hồ sơ của tôi
              </a>
            </li>
            
            <li>
              <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                <button type="submit"
                  class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6 border-0 bg-transparent w-100 text-start">
                  <i class="ri-shut-down-line"></i>
                  Đăng xuất
                </button>
              </form>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>
