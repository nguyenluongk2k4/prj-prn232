<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  @await Html.PartialAsync("_HeadPartial")
  @RenderSection("Head", required: false)
</head>
<body>
  <!-- Theme Customization -->
  @await Html.PartialAsync("_ThemeCustomization")
  
  <!-- Overlay -->
  <div class="overlay bg-black bg-opacity-50 w-100 h-100 position-fixed z-9 visibility-hidden opacity-0 duration-300"></div>

  <!-- Sidebar - Render based on role -->
  @{
      var role = (Context.Session.GetString("Role") ?? ViewData["Role"]?.ToString())?.Trim();
      var studentId = Context.Session.GetInt32("StudentId");
      var lecturerId = Context.Session.GetInt32("LecturerId");

      if (string.IsNullOrWhiteSpace(role))
      {
          if (studentId.HasValue)
          {
              role = "Student";
          }
          else if (lecturerId.HasValue)
          {
              role = "Teacher";
          }
      }
      var roleKey = role?.ToLowerInvariant();
  }
  @if (!string.IsNullOrEmpty(role))
  {
      var sidebarName = roleKey switch
      {
          "student" => "_Sidebar-Student",
          "teacher" => "_Sidebar-Teacher",
          "parent" => "_Sidebar-Parent",
          _ => "_Sidebar-Admin"
      };
      @await Html.PartialAsync(sidebarName)
  }
  else
  {
      <!-- Default sidebar for auth pages -->
      @await Html.PartialAsync("_Sidebar-Admin")
  }
  
  <!-- Main Content -->
  <main class="dashboard-main">

    <!-- Header -->
    @await Html.PartialAsync("_Header")

    <!-- Page Content -->
    <div class="main-content__wrapper">
      @RenderBody()
    </div>

    <!-- Footer -->
    @await Html.PartialAsync("_Footer")
  </main>
  
  <!-- Scripts -->
  @await Html.PartialAsync("_ScriptsPartial")
  @RenderSection("Scripts", required: false)
</body>

</html>
