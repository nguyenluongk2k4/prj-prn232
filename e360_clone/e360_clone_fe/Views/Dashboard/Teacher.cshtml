@model e360_clone_fe.Models.ViewModels.TeacherDashboardViewModel
@{
    ViewData["Title"] = "Dashboard giảng viên";
    Layout = "_Layout";
}

<style>
    .min-h-180 { min-height: 180px; }
    .teacher-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
    }
    .kpi-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        height: 100%;
    }
    .kpi-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .kpi-title {
        font-size: 0.95rem;
        color: #6b7280;
    }
    .kpi-value {
        font-weight: 700;
        font-size: 1.8rem;
        color: #111827;
        line-height: 1;
    }
    .teacher-name {
        font-size: 1.1rem;
        font-weight: 700;
    }
    .teacher-meta {
        font-size: 0.95rem;
    }
</style>

<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
        <div>
            <h6 class="fw-semibold mb-0">Dashboard giảng viên</h6>
            <p class="text-neutral-600 mt-4 mb-0">Theo dõi lịch coi thi và trạng thái ký giấy.</p>
        </div>
    </div>

    <div class="row gy-4 align-items-stretch">
        <div class="col-xxl-4">
            <div class="card radius-12 border-0 h-100 min-h-180">
                <div class="card-body p-24 teacher-card">
                    <div class="d-flex align-items-center gap-16">
                        <img src="@Model.AvatarUrl" alt="Avatar" class="w-72-px h-72-px rounded-circle object-fit-cover flex-shrink-0">
                        <div>
                            <div class="mb-4 teacher-name">@Model.TeacherName</div>
                            <div class="teacher-meta text-secondary-light">Mã GV: @(!string.IsNullOrWhiteSpace(Model.TeacherCode) ? Model.TeacherCode : "-")</div>
                            <div class="teacher-meta text-secondary-light">Email: @(!string.IsNullOrWhiteSpace(Model.Email) ? Model.Email : "-")</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-8 mt-16">
                        <a class="btn btn-primary-600" href="/ExamSchedules/My">Lịch coi thi</a>
                        <a class="btn btn-outline-primary" href="/Attendance/My">Điểm danh thi</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-8">
            <div class="row gy-4 align-items-stretch">
                <div class="col-md-4">
                    <div class="card radius-12 border-0 h-100 min-h-180">
                        <div class="card-body p-20 kpi-card">
                            <div class="kpi-row">
                                <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-primary-100 text-primary-600">
                                    <i class="ri-calendar-check-line"></i>
                                </span>
                                <div>
                                    <div class="kpi-title">Ca coi thi sắp tới</div>
                                    <div class="kpi-value">@Model.UpcomingAssignments</div>
                                </div>
                            </div>
                            <div class="text-sm text-secondary-light">Trong 14 ngày tới</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card radius-12 border-0 h-100 min-h-180">
                        <div class="card-body p-20 kpi-card">
                            <div class="kpi-row">
                                <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-success-100 text-success-600">
                                    <i class="ri-shield-user-line"></i>
                                </span>
                                <div>
                                    <div class="kpi-title">Tổng ca phân công</div>
                                    <div class="kpi-value">@Model.TotalAssignments</div>
                                </div>
                            </div>
                            <div class="text-sm text-secondary-light">Tổng số ca đã nhận</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card radius-12 border-0 h-100 min-h-180">
                        <div class="card-body p-20 kpi-card">
                            <div class="kpi-row">
                                <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-warning-100 text-warning-600">
                                    <i class="ri-file-warning-line"></i>
                                </span>
                                <div>
                                    <div class="kpi-title">Ca chưa ký đủ</div>
                                    <div class="kpi-value">@Model.UnconfirmedAssignments</div>
                                </div>
                            </div>
                            <div class="text-sm text-secondary-light">Theo báo cáo ký giấy</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row gy-4 mt-4">
        <div class="col-md-4">
            <div class="card radius-12 border-0 h-100 min-h-180">
                <div class="card-body p-20 kpi-card">
                    <div class="kpi-row">
                        <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-info-100 text-info-600">
                            <i class="ri-timer-line"></i>
                        </span>
                        <div>
                            <div class="kpi-title">Ca coi thi hôm nay</div>
                            <div class="kpi-value">@Model.TodayAssignments</div>
                        </div>
                    </div>
                    <div class="text-sm text-secondary-light">Ngày @DateTime.Today.ToString("dd/MM/yyyy")</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card radius-12 border-0 h-100 min-h-180">
                <div class="card-body p-20 kpi-card">
                    <div class="kpi-row">
                        <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-primary-100 text-primary-600">
                            <i class="ri-calendar-2-line"></i>
                        </span>
                        <div>
                            <div class="kpi-title">Ca trong 7 ngày</div>
                            <div class="kpi-value">@Model.WeekAssignments</div>
                        </div>
                    </div>
                    <div class="text-sm text-secondary-light">Từ hôm nay đến 7 ngày tới</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card radius-12 border-0 h-100 min-h-180">
                <div class="card-body p-20 kpi-card">
                    <div class="kpi-row">
                        <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-success-100 text-success-600">
                            <i class="ri-check-double-line"></i>
                        </span>
                        <div>
                            <div class="kpi-title">Tỷ lệ ký giấy</div>
                            <div class="kpi-value">@Model.ConfirmedRate%</div>
                        </div>
                    </div>
                    <div class="text-sm text-secondary-light">Theo dữ liệu ký gần đây</div>
                </div>
            </div>
        </div>
    </div>

    @* Lịch giảng dạy tạm ẩn theo yêu cầu *@

    <div class="row gy-4 mt-4">
        <div class="col-xxl-7">
            <div class="card radius-12 border-0 h-100">
                <div class="d-flex align-items-center justify-content-between py-12 px-20 border-bottom border-neutral-200">
                    <h6 class="mb-0 fw-bold text-lg">Lịch coi thi sắp tới</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Giờ</th>
                                    <th>Môn thi</th>
                                    <th>Lớp</th>
                                    <th>Phòng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UpcomingExams.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-secondary-light py-24">Chưa có lịch coi thi trong 14 ngày tới.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var exam in Model.UpcomingExams)
                                    {
                                        <tr>
                                            <td>@exam.ExamDate.ToString("dd/MM/yyyy")</td>
                                            <td>@exam.StartTime.ToString(@"hh\:mm") - @exam.EndTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="fw-medium">@exam.SubjectCode</div>
                                                <div class="text-sm text-secondary-light">@exam.SubjectName</div>
                                            </td>
                                            <td>@(!string.IsNullOrWhiteSpace(exam.ClassCode) ? exam.ClassCode : "-")</td>
                                            <td>@(!string.IsNullOrWhiteSpace(exam.RoomCode) ? exam.RoomCode : "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-5">
            <div class="card radius-12 border-0 h-100">
                <div class="d-flex align-items-center justify-content-between py-12 px-20 border-bottom border-neutral-200">
                    <h6 class="mb-0 fw-bold text-lg">Ca thi chưa ký đủ</h6>
                    <a class="text-primary-600 fw-medium" href="/Attendance/Reports">Xem báo cáo</a>
                </div>
                <div class="card-body">
                    @if (Model.UnconfirmedExams.Count == 0)
                    {
                        <div class="text-center text-secondary-light py-24">Tất cả ca thi đã ký đủ.</div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-16">
                            @foreach (var item in Model.UnconfirmedExams)
                            {
                                <div class="d-flex align-items-start justify-content-between gap-12">
                                    <div>
                                        <div class="fw-medium">@item.SubjectCode - @item.SubjectName</div>
                                        <div class="text-sm text-secondary-light">@item.ExamDate.ToString("dd/MM/yyyy") · @item.StartTime.ToString(@"hh\:mm")-@item.EndTime.ToString(@"hh\:mm")</div>
                                        <div class="text-sm text-secondary-light">Lớp: @item.ClassCode · Phòng: @(!string.IsNullOrWhiteSpace(item.RoomCode) ? item.RoomCode : "-")</div>
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-semibold">Chưa ký: @item.UnconfirmedCount/@item.TotalCount</div>
                                        <a class="btn btn-outline-primary btn-sm mt-8" href="/Attendance?examId=@item.ExamId&onlyUnconfirmed=true">Xử lý</a>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
