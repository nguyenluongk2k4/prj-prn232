@model e360_clone_fe.Models.ViewModels.StudentDashboardViewModel
@{
    ViewData["Title"] = "Dashboard sinh viên";
    Layout = "_Layout";
}

<style>
    .min-h-180 { min-height: 180px; }
    .student-card {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .kpi-card {
        display: flex;
        flex-direction: column;
        justify-content: center;
        gap: 12px;
        height: 100%;
    }
    .kpi-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .kpi-title {
        font-size: 0.95rem;
        color: #6b7280;
    }
    .kpi-value {
        font-weight: 700;
        font-size: 1.8rem;
        color: #111827;
        line-height: 1;
    }
    .student-name {
        font-size: 1.1rem;
        font-weight: 700;
    }
    .student-meta {
        font-size: 0.95rem;
    }
</style>

<div class="dashboard-main-body">
    <div class="breadcrumb d-flex flex-wrap align-items-center justify-content-between gap-3 mb-24">
        <div>
            <h6 class="fw-semibold mb-0">Dashboard sinh viên</h6>
            <p class="text-neutral-600 mt-4 mb-0">Theo dõi lịch thi và kết quả môn học.</p>
        </div>
    </div>

    <div class="row gy-4 align-items-stretch">
        <div class="col-xxl-4">
            <div class="card radius-12 border-0 h-100 min-h-180">
                <div class="card-body p-24 student-card">
                    <div class="d-flex align-items-center gap-16">
                        <img src="@Model.AvatarUrl" alt="Avatar" class="w-72-px h-72-px rounded-circle object-fit-cover flex-shrink-0">
                        <div>
                            <div class="mb-4 student-name">@Model.StudentName</div>
                            <div class="student-meta text-secondary-light">Mã SV: @(!string.IsNullOrWhiteSpace(Model.StudentCode) ? Model.StudentCode : "-")</div>
                            <div class="student-meta text-secondary-light">Lớp: @(!string.IsNullOrWhiteSpace(Model.ClassCode) ? Model.ClassCode : "-")</div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-8 mt-16">
                        <a class="btn btn-primary-600" href="/ExamSchedules/MyStudent">Xem lịch thi</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xxl-8">
            <div class="row gy-4 align-items-stretch">
                <div class="col-md-6">
                    <div class="card radius-12 border-0 h-100 min-h-180">
                        <div class="card-body p-20 kpi-card">
                            <div class="kpi-row">
                                <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-primary-100 text-primary-600">
                                    <i class="ri-calendar-check-line"></i>
                                </span>
                                <div>
                                    <div class="kpi-title">Ca thi sắp tới</div>
                                    <div class="kpi-value">@Model.UpcomingExamCount</div>
                                </div>
                            </div>
                            <div class="text-sm text-secondary-light">Trong 2 tuần gần nhất</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card radius-12 border-0 h-100 min-h-180">
                        <div class="card-body p-20 kpi-card">
                            <div class="kpi-row">
                                <span class="w-48-px h-48-px d-inline-flex justify-content-center align-items-center rounded-circle bg-success-100 text-success-600">
                                    <i class="ri-book-open-line"></i>
                                </span>
                                <div>
                                    <div class="kpi-title">Môn đang học</div>
                                    <div class="kpi-value">@Model.SubjectCount</div>
                                </div>
                            </div>
                            <div class="text-sm text-secondary-light">Tổng số môn trong kỳ</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row gy-4 mt-4">
        <div class="col-12">
            <div class="card radius-12 border-0 h-100">
                <div class="d-flex align-items-center justify-content-between py-12 px-20 border-bottom border-neutral-200">
                    <h6 class="mb-0 fw-bold text-lg">Lịch thi sắp tới</h6>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table mb-0">
                            <thead>
                                <tr>
                                    <th>Ngày</th>
                                    <th>Giờ</th>
                                    <th>Môn thi</th>
                                    <th>Phòng</th>
                                    <th>Ghế</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.UpcomingExams.Count == 0)
                                {
                                    <tr>
                                        <td colspan="5" class="text-center text-secondary-light py-24">Chưa có lịch thi trong 2 tuần tới.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var exam in Model.UpcomingExams)
                                    {
                                        <tr>
                                            <td>@exam.ExamDate.ToString("dd/MM/yyyy")</td>
                                            <td>@exam.StartTime.ToString(@"hh\:mm") - @exam.EndTime.ToString(@"hh\:mm")</td>
                                            <td>
                                                <div class="fw-medium">@exam.SubjectCode</div>
                                                <div class="text-sm text-secondary-light">@exam.SubjectName</div>
                                            </td>
                                            <td>@(!string.IsNullOrWhiteSpace(exam.RoomCode) ? exam.RoomCode : "-")</td>
                                            <td>@(exam.SeatNumber > 0 ? exam.SeatNumber.ToString() : "-")</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
