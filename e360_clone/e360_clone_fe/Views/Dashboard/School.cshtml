@{
    ViewData["Title"] = "School Dashboard";
}

<!-- Breadcrumb -->
<div class="breadcrumb-area py-20 px-24 bg-neutral-50">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="text-2xl fw-bold mb-2 text-primary-light">School Dashboard</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="/">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
                </ol>
            </nav>
        </div>
    </div>
</div>

<!-- Content Area -->
<div class="content-area p-24">
    <!-- Statistics Cards -->
    <div class="row g-4 mb-24">
        <div class="col-md-6 col-xxl-3">
            <div class="card radius-12 bg-primary-600 text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-2 opacity-75">Total Students</p>
                            <h3 class="mb-0 fw-bold">1,234</h3>
                        </div>
                        <div class="text-4xl opacity-75">
                            <i class="ri-graduation-cap-line"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xxl-3">
            <div class="card radius-12 bg-success-600 text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-2 opacity-75">Total Teachers</p>
                            <h3 class="mb-0 fw-bold">86</h3>
                        </div>
                        <div class="text-4xl opacity-75">
                            <i class="ri-user-follow-line"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xxl-3">
            <div class="card radius-12 bg-warning-600 text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-2 opacity-75">Total Classes</p>
                            <h3 class="mb-0 fw-bold">42</h3>
                        </div>
                        <div class="text-4xl opacity-75">
                            <i class="ri-list-view"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xxl-3">
            <div class="card radius-12 bg-info-600 text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <p class="mb-2 opacity-75">Exams Scheduled</p>
                            <h3 class="mb-0 fw-bold">18</h3>
                        </div>
                        <div class="text-4xl opacity-75">
                            <i class="ri-file-edit-line"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="card radius-12 mb-24">
        <div class="card-body p-24">
            <h2 class="text-xl fw-bold mb-3 text-primary-light">Quick Actions</h2>
            <div class="row g-4">
                <div class="col-md-3">
                    <a href="/Students" class="card radius-12 border bg-hover-neutral-50 text-decoration-none">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-48-px h-48-px rounded-circle bg-primary-100 text-primary-600 d-flex align-items-center justify-content-center text-2xl">
                                    <i class="ri-graduation-cap-line"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-primary-light">Students</h6>
                                    <p class="text-sm text-secondary-light mb-0">Manage Students</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Teachers" class="card radius-12 border bg-hover-neutral-50 text-decoration-none">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-48-px h-48-px rounded-circle bg-success-100 text-success-600 d-flex align-items-center justify-content-center text-2xl">
                                    <i class="ri-user-follow-line"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-success-600">Teachers</h6>
                                    <p class="text-sm text-secondary-light mb-0">Manage Teachers</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Exams" class="card radius-12 border bg-hover-neutral-50 text-decoration-none">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-48-px h-48-px rounded-circle bg-warning-100 text-warning-600 d-flex align-items-center justify-content-center text-2xl">
                                    <i class="ri-file-edit-line"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-warning-600">Exams</h6>
                                    <p class="text-sm text-secondary-light mb-0">Manage Exams</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
                <div class="col-md-3">
                    <a href="/Classes" class="card radius-12 border bg-hover-neutral-50 text-decoration-none">
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div class="w-48-px h-48-px rounded-circle bg-info-100 text-info-600 d-flex align-items-center justify-content-center text-2xl">
                                    <i class="ri-list-view"></i>
                                </div>
                                <div>
                                    <h6 class="mb-0 text-info-600">Classes</h6>
                                    <p class="text-sm text-secondary-light mb-0">Manage Classes</p>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="card radius-12">
        <div class="card-body p-24">
            <h2 class="text-xl fw-bold mb-3 text-primary-light">Recent Activity</h2>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="bg-neutral-100">
                        <tr>
                            <th>Activity</th>
                            <th>User</th>
                            <th>Time</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>New student registered</td>
                            <td>John Doe</td>
                            <td>5 mins ago</td>
                            <td><span class="badge bg-success">Completed</span></td>
                        </tr>
                        <tr>
                            <td>Exam schedule created</td>
                            <td>Admin</td>
                            <td>1 hour ago</td>
                            <td><span class="badge bg-success">Completed</span></td>
                        </tr>
                        <tr>
                            <td>Teacher assignment</td>
                            <td>Jane Smith</td>
                            <td>2 hours ago</td>
                            <td><span class="badge bg-warning">Pending</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
