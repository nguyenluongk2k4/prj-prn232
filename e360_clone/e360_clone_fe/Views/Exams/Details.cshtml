@model e360_clone_fe.Models.ViewModels.ExamViewModel
@{
    ViewData["Title"] = "Chi tiết kỳ thi";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Chi tiết kỳ thi</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Kỳ thi</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                    </ul>
                </nav>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-600">
                    <i class="ri-edit-line"></i> Sửa
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ri-arrow-left-line"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <div class="content-area p-24">
        <div class="card h-100">
            <div class="card-body p-24">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Mã kỳ thi</div>
                        <div class="text-secondary-light">@Model.ExamCode</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Tên kỳ thi</div>
                        <div class="text-secondary-light">@Model.ExamName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Loại kỳ thi</div>
                        <div class="text-secondary-light">@Model.ExamType</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Ngày thi</div>
                        <div class="text-secondary-light">@Model.ExamDate.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Giờ thi</div>
                        <div class="text-secondary-light">@Model.StartTime.ToString(@"hh\:mm") - @Model.EndTime.ToString(@"hh\:mm")</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Thời lượng</div>
                        <div class="text-secondary-light">@Model.Duration phút</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Học kỳ</div>
                        <div class="text-secondary-light">@Model.Semester</div>
                    </div>
                    <div class="col-md-6">
                        <div class="fw-semibold text-primary-light">Năm học</div>
                        <div class="text-secondary-light">@Model.AcademicYear</div>
                    </div>
                    <div class="col-md-12">
                        <div class="fw-semibold text-primary-light">Ghi chú</div>
                        <div class="text-secondary-light">@Model.Notes</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
