@model e360_clone_fe.Models.ViewModels.PagedViewModel<e360_clone_fe.Models.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="main-content__wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Danh sách sinh viên</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item">Sinh viên</li>
                        <li class="breadcrumb-item active" aria-current="page">Danh sách</li>
                    </ul>
                </nav>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-primary-600">
                    <i class="ri-add-line"></i> Thêm sinh viên
                </a>
            </div>
        </div>
    </div>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="ri-check-line"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Content Area -->
    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body">
                <!-- Search & Filter -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-20">
                    <form method="get" class="d-flex align-items-center gap-3">
                        <div class="search-box position-relative">
                            <input type="text" name="searchTerm" class="form-control w-300-px" 
                                   placeholder="Tìm theo tên hoặc mã..." 
                                   value="@Model.SearchTerm">
                            <i class="ri-search-line position-absolute top-50 end-0 translate-middle-y me-12 text-secondary-light"></i>
                        </div>
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="ri-search-line"></i> Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="ri-close-line"></i> Xóa bộ lọc
                            </a>
                        }
                    </form>
                </div>

                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="bg-neutral-100">
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">Mã SV</th>
                                <th scope="col">Họ và tên</th>
                                <th scope="col">Ngày sinh</th>
                                <th scope="col">Giới tính</th>
                                <th scope="col">Email</th>
                                <th scope="col">Số điện thoại</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                var index = Model.StartRecord;
                                @foreach (var student in Model.Items)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>@student.StudentCode</td>
                                        <td>@student.FullName</td>
                                        <td>@student.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                        <td>@student.GenderText</td>
                                        <td>@student.Email</td>
                                        <td>@student.PhoneNumber</td>
                                        <td>
                                            <span class="badge @student.StatusBadgeClass">@student.StatusText</span>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-2">
                                                <a asp-action="Details" asp-route-id="@student.Id" 
                                                   class="btn btn-sm btn-outline-info" 
                                                   title="Xem chi tiết">
                                                    <i class="ri-eye-line"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@student.Id" 
                                                   class="btn btn-sm btn-outline-primary" 
                                                   title="Sửa">
                                                    <i class="ri-edit-line"></i>
                                                </a>
                                                <form asp-action="Delete" asp-route-id="@student.Id" 
                                                      method="post" 
                                                      class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc muốn xóa sinh viên này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" 
                                                            title="Xóa">
                                                        <i class="ri-delete-bin-line"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center py-4">
                                        <i class="ri-inbox-line text-muted" style="font-size: 48px;"></i>
                                        <p class="text-muted mt-2">Không có sinh viên nào</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Page navigation" class="mt-20">
                        <ul class="pagination justify-content-end mb-0">
                            <!-- First Page -->
                            @if (Model.HasPrevious)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="1" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ri-double-left-line"></i>
                                    </a>
                                </li>
                            }

                            <!-- Previous Page -->
                            @if (Model.HasPrevious)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="@(Model.PageNumber - 1)" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ri-arrow-left-s-line"></i>
                                    </a>
                                </li>
                            }

                            <!-- Page Numbers -->
                            @{
                                var startPage = Math.Max(1, Model.PageNumber - 2);
                                var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                            }

                            @for (var i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="@i" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        @i
                                    </a>
                                </li>
                            }

                            <!-- Next Page -->
                            @if (Model.HasNext)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="@(Model.PageNumber + 1)" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ri-arrow-right-s-line"></i>
                                    </a>
                                </li>
                            }

                            <!-- Last Page -->
                            @if (Model.HasNext)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" 
                                       asp-route-pageNumber="@Model.TotalPages" 
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm">
                                        <i class="ri-double-right-line"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>

                    <!-- Page Info -->
                    <div class="text-muted text-end mt-2">
                        <small>Hiển thị @Model.StartRecord - @Model.EndRecord trong tổng số @Model.TotalRecords bản ghi</small>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
        });
    </script>
}
