@{
    ViewData["Title"] = "Student List";
}

<div class="main-content__wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Student List</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Home</a></li>
                        <li class="breadcrumb-item">Students</li>
                        <li class="breadcrumb-item active" aria-current="page">List</li>
                    </ol>
                </nav>
            </div>
            <div>
                <button type="button" class="btn btn-primary-600" data-bs-toggle="modal" data-bs-target="#studentModal" onclick="StudentUI.prepareAdd()">
                    <i class="ri-add-line"></i> Add New Student
                </button>
            </div>
        </div>
    </div>
    
    <!-- Content Area -->
    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body">
                <!-- Search & Filter -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-20">
                    <div class="d-flex align-items-center gap-3">
                        <div class="search-box position-relative">
                            <input type="text" id="searchInput" class="form-control w-300-px" placeholder="Search by name or code...">
                            <i class="ri-search-line position-absolute top-50 end-0 translate-middle-y me-12 text-secondary-light"></i>
                        </div>
                        <button type="button" class="btn btn-outline-secondary" onclick="StudentUI.search()">
                            <i class="ri-search-line"></i> Search
                        </button>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <select class="form-select w-auto">
                            <option value="">All Classes</option>
                            <option value="1">Class 10A</option>
                            <option value="2">Class 10B</option>
                            <option value="3">Class 11A</option>
                        </select>
                        <select class="form-select w-auto">
                            <option value="">All Status</option>
                            <option value="Active">Active</option>
                            <option value="Inactive">Inactive</option>
                            <option value="Graduated">Graduated</option>
                        </select>
                    </div>
                </div>
                
                <!-- Data Table -->
                <div class="table-responsive">
                    <table class="table table-hover" id="studentsTable">
                        <thead class="bg-neutral-100">
                            <tr>
                                <th scope="col">Student Code</th>
                                <th scope="col">Full Name</th>
                                <th scope="col">Date of Birth</th>
                                <th scope="col">Gender</th>
                                <th scope="col">Email</th>
                                <th scope="col">Phone</th>
                                <th scope="col">Status</th>
                                <th scope="col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td colspan="8" class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading...</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <!-- Pagination -->
                <nav aria-label="Page navigation" class="mt-20">
                    <ul class="pagination justify-content-end mb-0" id="pagination"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Student Modal -->
<div class="modal fade" id="studentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content radius-16 bg-base">
            <div class="modal-header border-bottom px-24 py-16">
                <h5 class="modal-title text-lg fw-bold" id="modalTitle">Add Student</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-24">
                <form id="studentForm">
                    <input type="hidden" id="studentId">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Student Code <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="studentCode" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Full Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="fullName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Date of Birth <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="dateOfBirth" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Gender <span class="text-danger">*</span></label>
                            <select class="form-select" id="gender" required>
                                <option value="">Select...</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Email <span class="text-danger">*</span></label>
                            <input type="email" class="form-control" id="email" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Phone Number</label>
                            <input type="tel" class="form-control" id="phoneNumber">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-medium">Address</label>
                            <input type="text" class="form-control" id="address">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Class</label>
                            <select class="form-select" id="classId">
                                <option value="">Select Class...</option>
                                <option value="1">Class 10A</option>
                                <option value="2">Class 10B</option>
                                <option value="3">Class 11A</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-medium">Status <span class="text-danger">*</span></label>
                            <select class="form-select" id="status" required>
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                                <option value="Graduated">Graduated</option>
                            </select>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-top px-24 py-16">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary-600" onclick="StudentUI.save()">Save Changes</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Core libraries -->
    <script src="~/js/core/http.js"></script>
    <script src="~/js/core/auth.js"></script>
    
    <!-- Student module -->
    <script src="~/js/modules/students/api.js"></script>
    <script src="~/js/modules/students/helpers.js"></script>
    <script src="~/js/modules/students/ui.js"></script>
    
    <!-- Page initialization -->
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Check authentication
            if (!Auth.isAuthenticated()) {
                Auth.setRedirectUrl(window.location.pathname);
                window.location.href = '/Auth/Login';
                return;
            }
            
            // Initialize Students UI
            if (typeof StudentsUI !== 'undefined') {
                StudentsUI.init();
            }
        });
    </script>
}
