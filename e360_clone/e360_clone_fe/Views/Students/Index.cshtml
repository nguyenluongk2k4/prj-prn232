@model e360_clone_fe.Models.ViewModels.PagedViewModel<e360_clone_fe.Models.ViewModels.StudentViewModel>
@{
    ViewData["Title"] = "Danh sách sinh viên";
}

<div class="main-content__wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Danh sách sinh viên</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item">Sinh viên</li>
                        <li class="breadcrumb-item active" aria-current="page">Danh sách</li>
                    </ul>
                </nav>
            </div>
            @{
                var role = Context.Session.GetString("Role") ?? string.Empty;
                var isAdmin = role.Contains("admin", StringComparison.OrdinalIgnoreCase);
            }
            @if (isAdmin)
            {
                <div>
                    <a asp-action="Create" class="btn btn-primary-600">
                        <i class="ri-add-line"></i> Thêm sinh viên
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Flash Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="ri-check-line"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Content Area -->
    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body p-0 dataTable-wrapper">
                <!-- Search & Filter -->
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-16 px-20 py-12 border-bottom border-neutral-200">
                    <form method="get" class="d-flex align-items-center gap-16 flex-wrap">
                        <input type="hidden" name="pageNumber" value="1" />
                        @if (ViewBag.ClassId != null)
                        {
                            <input type="hidden" name="classId" value="@ViewBag.ClassId" />
                        }
                        <div class="navbar-search dt-search m-0">
                            <input type="text" class="dt-input bg-transparent radius-4" name="searchTerm"
                                   placeholder="Search..." value="@Model.SearchTerm">
                            <iconify-icon icon="ion:search-outline" class="icon"></iconify-icon>
                        </div>
                        <div class="d-flex align-items-center gap-8 text-secondary-light">
                            <span>Rows per page:</span>
                            <div class="dt-length">
                                <select name="pageSize" class="dt-input form-control form-select" onchange="this.form.submit()">
                                    @if (Model.PageSize == 5)
                                    {
                                        <option value="5" selected>5</option>
                                    }
                                    else
                                    {
                                        <option value="5">5</option>
                                    }
                                    @if (Model.PageSize == 10)
                                    {
                                        <option value="10" selected>10</option>
                                    }
                                    else
                                    {
                                        <option value="10">10</option>
                                    }
                                    @if (Model.PageSize == 25)
                                    {
                                        <option value="25" selected>25</option>
                                    }
                                    else
                                    {
                                        <option value="25">25</option>
                                    }
                                    @if (Model.PageSize == 50)
                                    {
                                        <option value="50" selected>50</option>
                                    }
                                    else
                                    {
                                        <option value="50">50</option>
                                    }
                                    @if (Model.PageSize == 100)
                                    {
                                        <option value="100" selected>100</option>
                                    }
                                    else
                                    {
                                        <option value="100">100</option>
                                    }
                                </select>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-outline-secondary">
                            <i class="ri-search-line"></i> Tìm kiếm
                        </button>
                        @if (!string.IsNullOrEmpty(Model.SearchTerm))
                        {
                            <a asp-action="Index" asp-route-classId="@ViewBag.ClassId" class="btn btn-outline-secondary">
                                <i class="ri-close-line"></i> Xóa bộ lọc
                            </a>
                        }
                    </form>
                </div>

                <!-- Data Table -->
                <div class="p-0">
                    <table class="table bordered-table mb-0 data-table">
                        <thead class="bg-neutral-100">
                            <tr>
                                <th scope="col">STT</th>
                                <th scope="col">Avatar</th>
                                <th scope="col">Mã SV</th>
                                <th scope="col">Họ và tên</th>
                                <th scope="col">Ngày sinh</th>
                                <th scope="col">Giới tính</th>
                                <th scope="col">Email</th>
                                <th scope="col">Số điện thoại</th>
                                <th scope="col">Trạng thái</th>
                                <th scope="col">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Items.Any())
                            {
                                var index = Model.StartRecord;
                                @foreach (var student in Model.Items)
                                {
                                    <tr>
                                        <td>@index</td>
                                        <td>
                                            @{
                                                var avatarSrc = !string.IsNullOrWhiteSpace(student.AvatarUrl)
                                                    ? student.AvatarUrl
                                                    : "/assets/images/thumbs/avatar-img1.png";
                                            }
                                            <button type="button"
                                                    class="btn p-0 border-0 bg-transparent"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#studentAvatarModal"
                                                    data-avatar-src="@avatarSrc"
                                                    data-avatar-name="@student.FullName">
                                                <img src="@avatarSrc" alt="@student.FullName"
                                                     class="w-32-px h-32-px rounded-circle object-fit-cover">
                                            </button>
                                        </td>
                                        <td>@student.StudentCode</td>
                                        <td>@student.FullName</td>
                                        <td>@student.DateOfBirth.ToString("dd/MM/yyyy")</td>
                                        <td>@student.GenderText</td>
                                        <td>@student.Email</td>
                                        <td>@student.PhoneNumber</td>
                                        <td>
                                            <span class="badge @student.StatusBadgeClass">@student.StatusText</span>
                                        </td>
                                        <td>
                                            <div class="btn-group">
                                                <button type="button" class="text-primary-light text-xl"
                                                        data-bs-toggle="dropdown" data-bs-display="static"
                                                        aria-expanded="false">
                                                    <iconify-icon icon="tabler:dots-vertical"></iconify-icon>
                                                </button>
                                                <ul class="dropdown-menu dropdown-menu-lg-end border p-12">
                                                    <li>
                                                        <a asp-action="Details" asp-route-id="@student.Id"
                                                           class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6">
                                                            <i class="ri-eye-line"></i>
                                                            Xem chi tiết
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a asp-action="Edit" asp-route-id="@student.Id"
                                                           class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6">
                                                            <i class="ri-edit-2-line"></i>
                                                            Sửa
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <form asp-action="Delete" asp-route-id="@student.Id"
                                                              method="post"
                                                              onsubmit="return confirm('Bạn có chắc muốn xóa sinh viên này?');">
                                                            @Html.AntiForgeryToken()
                                                            <button type="submit"
                                                                    class="dropdown-item rounded text-secondary-light bg-hover-neutral-200 text-hover-neutral-900 d-flex align-items-center gap-2 py-6 border-0 bg-transparent w-100 text-start">
                                                                <i class="ri-delete-bin-6-line"></i>
                                                                Xóa
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                    index++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="10" class="text-center py-4">
                                        <i class="ri-inbox-line text-muted" style="font-size: 48px;"></i>
                                        <p class="text-muted mt-2">Không có sinh viên nào</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-16 px-20 py-12 border-top border-neutral-200 dataTable-bottom">
                        <div class="text-secondary-light text-sm dataTable-info">
                            Hiển thị @Model.StartRecord - @Model.EndRecord trong tổng số @Model.TotalRecords bản ghi
                        </div>
                        <div class="dataTable-pagination">
                            <ul class="pagination mb-0">
                                <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@(Model.PageNumber - 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-classId="@ViewBag.ClassId">
                                        Previous
                                    </a>
                                </li>

                                @{
                                    var startPage = Math.Max(1, Model.PageNumber - 2);
                                    var endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                                }

                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                        <a class="page-link" asp-action="Index"
                                           asp-route-pageNumber="@i"
                                           asp-route-pageSize="@Model.PageSize"
                                           asp-route-searchTerm="@Model.SearchTerm"
                                           asp-route-classId="@ViewBag.ClassId">
                                            @i
                                        </a>
                                    </li>
                                }

                                <li class="page-item @(Model.HasNext ? "" : "disabled")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pageNumber="@(Model.PageNumber + 1)"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-classId="@ViewBag.ClassId">
                                        Next
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="studentAvatarModal" tabindex="-1" aria-labelledby="studentAvatarModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title" id="studentAvatarModalLabel">Avatar sinh viên</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center">
                <img id="studentAvatarModalImage" src="/assets/images/thumbs/avatar-img1.png" alt="Student Avatar"
                     class="rounded-circle object-fit-cover" style="width: 180px; height: 180px;">
                <div class="mt-12 fw-semibold" id="studentAvatarModalName"></div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        // Auto-dismiss alerts after 5 seconds
        document.addEventListener('DOMContentLoaded', function() {
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(function(alert) {
                setTimeout(function() {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                }, 5000);
            });
            const avatarModal = document.getElementById('studentAvatarModal');
            if (avatarModal) {
                avatarModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    if (!button) return;
                    const src = button.getAttribute('data-avatar-src');
                    const name = button.getAttribute('data-avatar-name');
                    const img = document.getElementById('studentAvatarModalImage');
                    const label = document.getElementById('studentAvatarModalName');
                    if (img) {
                        img.src = src || '/assets/images/thumbs/avatar-img1.png';
                    }
                    if (label) {
                        label.textContent = name || '';
                    }
                });
            }        });
    </script>
}





