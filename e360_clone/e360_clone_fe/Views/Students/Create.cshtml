@model e360_clone_fe.Models.ViewModels.CreateStudentViewModel
@{
    ViewData["Title"] = "Thêm sinh viên";
}

<div class="main-content__wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Thêm sinh viên mới</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
                    </ul>
                </nav>
            </div>
            <div>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ri-arrow-left-line"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <!-- Content Area -->
    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="row g-4">
                        <!-- Basic Information -->
                        <div class="col-12">
                            <h5 class="fw-bold mb-3">Thông tin cơ bản</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="StudentCode" class="form-label fw-medium"></label>
                                    <input asp-for="StudentCode" class="form-control" placeholder="Nhập mã sinh viên" />
                                    <span asp-validation-for="StudentCode" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="FullName" class="form-label fw-medium"></label>
                                    <input asp-for="FullName" class="form-control" placeholder="Nhập họ và tên" />
                                    <span asp-validation-for="FullName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="DateOfBirth" class="form-label fw-medium"></label>
                                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Gender" class="form-label fw-medium"></label>
                                    <select asp-for="Gender" class="form-select">
                                        <option value="Nam">Nam</option>
                                        <option value="Nữ">Nữ</option>
                                        <option value="Khác">Khác</option>
                                    </select>
                                    <span asp-validation-for="Gender" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Contact Information -->
                        <div class="col-12">
                            <h5 class="fw-bold mb-3">Thông tin liên hệ</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Email" class="form-label fw-medium"></label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="email@example.com" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="PhoneNumber" class="form-label fw-medium"></label>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Số điện thoại" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Address" class="form-label fw-medium"></label>
                                    <input asp-for="Address" class="form-control" placeholder="Địa chỉ" />
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Academic Information -->
                        <div class="col-12">
                            <h5 class="fw-bold mb-3">Thông tin học tập</h5>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Ngành</label>
                                    <select id="majorSelect" class="form-select">
                                        <option value="">-- Chọn ngành --</option>
                                        <optgroup label="Khối Công nghệ">
                                            <option value="SE">SE - Software Engineering</option>
                                            <option value="AI">AI - Artificial Intelligence</option>
                                            <option value="IA">IA - Information Assurance</option>
                                            <option value="SWD">SWD - Software Development</option>
                                            <option value="PRJ">PRJ - Project</option>
                                        </optgroup>
                                        <optgroup label="Khối Kinh tế / Kinh doanh">
                                            <option value="BUS">BUS - Business</option>
                                            <option value="MKT">MKT - Marketing</option>
                                            <option value="FIN">FIN - Finance</option>
                                            <option value="ACC">ACC - Accounting</option>
                                        </optgroup>
                                        <optgroup label="Khối Ngôn ngữ / Quốc tế">
                                            <option value="EN">EN - English</option>
                                            <option value="JPN">JPN - Japanese</option>
                                            <option value="KOR">KOR - Korean</option>
                                            <option value="CHI">CHI - Chinese</option>
                                        </optgroup>
                                        <optgroup label="Khối Thiết kế / Truyền thông">
                                            <option value="GD">GD - Graphic Design</option>
                                            <option value="MM">MM - Multimedia Communication</option>
                                        </optgroup>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-medium">Khóa</label>
                                    <select id="cohortSelect" class="form-select">
                                        <option value="">-- Chọn khóa --</option>
                                        <option value="17">K17</option>
                                        <option value="18">K18</option>
                                        <option value="19">K19</option>
                                        <option value="20">K20</option>
                                        <option value="21">K21</option>
                                        <option value="22">K22</option>
                                        <option value="23">K23</option>
                                        <option value="24">K24</option>
                                        <option value="25">K25</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ClassId" class="form-label fw-medium"></label>
                                    <select asp-for="ClassId" class="form-select" id="classSelect">
                                        <option value="">-- Chọn lớp --</option>
                                    </select>
                                    <span asp-validation-for="ClassId" class="text-danger"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Status" class="form-label fw-medium"></label>
                                    <select asp-for="Status" class="form-select">
                                        <option value="Active">Đang học</option>
                                        <option value="Inactive">Tạm nghỉ</option>
                                        <option value="Graduated">Đã tốt nghiệp</option>
                                    </select>
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="col-12 mt-4">
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-primary-600">
                                    <i class="ri-save-line"></i> Lưu thông tin
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary">
                                    <i class="ri-close-line"></i> Hủy
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Auto-format phone number
        document.querySelector('#PhoneNumber')?.addEventListener('input', function(e) {
            let value = e.target.value.replace(/\D/g, '');
            if (value.length > 10) value = value.substring(0, 10);
            e.target.value = value;
        });

        (function () {
            const majorSelect = document.getElementById('majorSelect');
            const cohortSelect = document.getElementById('cohortSelect');
            const classSelect = document.getElementById('classSelect');
            const apiBase = window.APP_CONFIG?.API_BASE_URL || '/api';
            let classes = [];

            function resetClassOptions() {
                classSelect.innerHTML = '<option value="">-- Chọn lớp --</option>';
            }

            function renderClassOptions(items) {
                resetClassOptions();
                items.forEach(c => {
                    const option = document.createElement('option');
                    option.value = c.id;
                    option.textContent = `${c.classCode} - ${c.className}`;
                    classSelect.appendChild(option);
                });
            }

            async function loadClassesByFilter() {
                const major = majorSelect.value;
                const cohort = cohortSelect.value;

                if (!major || !cohort) {
                    resetClassOptions();
                    return;
                }

                try {
                    const url = `${apiBase}/classes?pageNumber=1&pageSize=200&majorCode=${encodeURIComponent(major)}&cohort=${encodeURIComponent(cohort)}`;
                    const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                    const json = await res.json();
                    classes = Array.isArray(json.data) ? json.data : [];
                    renderClassOptions(classes);
                } catch (err) {
                    console.error('Failed to load classes', err);
                    resetClassOptions();
                }
            }

            majorSelect?.addEventListener('change', loadClassesByFilter);
            cohortSelect?.addEventListener('change', loadClassesByFilter);

            if (majorSelect && cohortSelect && classSelect) {
                resetClassOptions();
            }
        })();
    </script>
}




