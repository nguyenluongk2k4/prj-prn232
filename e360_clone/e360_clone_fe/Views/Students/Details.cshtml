@model e360_clone_fe.Models.ViewModels.StudentViewModel
@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<div class="main-content__wrapper">
    <!-- Breadcrumb -->
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Chi tiết sinh viên</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Sinh viên</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                    </ul>
                </nav>
            </div>
            <div>
                <div class="d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary-600">
                        <i class="ri-edit-line"></i> Sửa
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="ri-arrow-left-line"></i> Quay lại
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Area -->
    <div class="content-area p-24">
        <div class="row g-4">
            <!-- Basic Information Card -->
            <div class="col-lg-8">
                <div class="card radius-12">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">Thông tin cơ bản</h5>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="ri-id-card-line text-secondary"></i>
                                    <span class="text-muted">Mã sinh viên:</span>
                                </div>
                                <p class="fw-semibold ms-24">@Model.StudentCode</p>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="ri-user-line text-secondary"></i>
                                    <span class="text-muted">Họ và tên:</span>
                                </div>
                                <p class="fw-semibold ms-24">@Model.FullName</p>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="ri-calendar-line text-secondary"></i>
                                    <span class="text-muted">Ngày sinh:</span>
                                </div>
                                <p class="fw-semibold ms-24">@Model.DateOfBirth.ToString("dd/MM/yyyy")</p>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <i class="ri-gender-line text-secondary"></i>
                                    <span class="text-muted">Giới tính:</span>
                                </div>
                                <p class="fw-semibold ms-24">@Model.GenderText</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Status Card -->
            <div class="col-lg-4">
                <div class="card radius-12">
                    <div class="card-body text-center">
                        <div class="mb-3">
                            <div class="avatar avatar-xxl rounded-circle bg-primary-100 text-primary-600 mb-3">
                                <span class="fs-3">@string.Join("", Model.FullName.Split(' ').Select(n => n.FirstOrDefault()).Take(2))</span>
                            </div>
                        </div>
                        <h5 class="fw-bold mb-2">@Model.FullName</h5>
                        <p class="text-muted mb-3">@Model.StudentCode</p>
                        <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusText</span>
                    </div>
                </div>
            </div>

            <!-- Contact Information Card -->
            <div class="col-lg-6">
                <div class="card radius-12">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">
                            <i class="ri-contact-book-line me-2"></i>Thông tin liên hệ
                        </h5>
                        
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                <i class="ri-mail-line fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Email</p>
                                <p class="fw-semibold mb-0">@Model.Email</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                <i class="ri-phone-line fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Số điện thoại</p>
                                <p class="fw-semibold mb-0">@Model.PhoneNumber</p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start gap-3">
                            <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                <i class="ri-map-pin-line fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Địa chỉ</p>
                                <p class="fw-semibold mb-0">@Model.Address</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Academic Information Card -->
            <div class="col-lg-6">
                <div class="card radius-12">
                    <div class="card-body">
                        <h5 class="fw-bold mb-4">
                            <i class="ri-school-line me-2"></i>Thông tin học tập
                        </h5>
                        
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                <i class="ri-team-line fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Lớp</p>
                                <p class="fw-semibold mb-0">
                                    @(Model.Class?.ClassName ?? "Chưa phân lớp")
                                </p>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-start gap-3 mb-3">
                            <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                <i class="ri-time-line fs-5"></i>
                            </div>
                            <div>
                                <p class="text-muted mb-1">Ngày tạo</p>
                                <p class="fw-semibold mb-0">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            </div>
                        </div>
                        
                        @if (Model.UpdatedAt.HasValue)
                        {
                            <div class="d-flex align-items-start gap-3">
                                <div class="icon-box bg-primary-100 text-primary-600 p-2 radius-8">
                                    <i class="ri-history-line fs-5"></i>
                                </div>
                                <div>
                                    <p class="text-muted mb-1">Cập nhật lần cuối</p>
                                    <p class="fw-semibold mb-0">@Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Add any page-specific scripts here
    </script>
}
