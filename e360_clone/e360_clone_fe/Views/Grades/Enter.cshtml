@model e360_clone_fe.Models.ViewModels.GradeImportPageViewModel
@{
    ViewData["Title"] = "Nhập điểm";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Nhập điểm</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item">Điểm</li>
                        <li class="breadcrumb-item active" aria-current="page">Nhập điểm</li>
                    </ul>
                </nav>
                <p class="text-secondary-light mt-2">Nhập điểm theo ca thi. Hỗ trợ import file hoặc nhập tay.</p>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="ri-checkbox-circle-line"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="content-area p-24">
        <div class="row g-4">
            <div class="col-xl-7">
                <div class="card radius-12 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-12">
                            <div>
                                <h6 class="mb-0">Import điểm hàng loạt</h6>
                                <div class="text-secondary-light text-sm">Tải file mẫu, điền điểm và import.</div>
                            </div>
                            <span class="badge bg-primary-100 text-primary-600">Nhanh</span>
                        </div>
                        <form asp-action="Enter" method="post" enctype="multipart/form-data" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-12">
                                <label class="form-label">Môn học</label>
                                <select class="form-select" name="subjectId" required>
                                    <option value="">-- Chọn môn --</option>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <option value="@subject.Id" selected="@(Model.SelectedSubjectId == subject.Id)">@subject.SubjectCode - @subject.SubjectName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Năm học</label>
                                <input type="text" class="form-control" name="academicYear" value="@Model.AcademicYear" placeholder="2025-2026" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Học kỳ</label>
                                <select class="form-select" name="semester" required>
                                    <option value="">-- Chọn kỳ --</option>
                                    <option value="1" selected="@(Model.Semester == 1)">Kỳ 1</option>
                                    <option value="2" selected="@(Model.Semester == 2)">Kỳ 2</option>
                                    <option value="3" selected="@(Model.Semester == 3)">Kỳ 3</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Loại điểm</label>
                                <select class="form-select" name="scoreType">
                                    @foreach (var type in Model.ScoreTypes)
                                    {
                                        <option value="@type.Value" selected="@(Model.ScoreType == type.Value)">@type.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">File điểm (CSV/XLSX)</label>
                                <input type="file" class="form-control" name="file" accept=".csv,.xlsx" required />
                            </div>
                            <div class="col-12 d-flex flex-wrap gap-8 align-items-center">
                                <button type="submit" class="btn btn-primary-600">Import điểm</button>
                                <a href="/Grades/Template" class="btn btn-outline-primary">Tải file mẫu</a>
                                <span class="text-secondary-light text-sm">Cột: StudentCode, Score, LetterGrade, Notes</span>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-xl-5">
                <div class="card radius-12 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center justify-content-between mb-12">
                            <div>
                                <h6 class="mb-0">Nhập điểm thủ công</h6>
                                <div class="text-secondary-light text-sm">Nhập nhanh cho từng sinh viên.</div>
                            </div>
                            <span class="badge bg-success-100 text-success-600">Linh hoạt</span>
                        </div>
                        <form asp-action="EnterManual" method="post" class="row g-3">
                            @Html.AntiForgeryToken()
                            <div class="col-12">
                                <label class="form-label">Môn học</label>
                                <select class="form-select" name="subjectId" required>
                                    <option value="">-- Chọn môn --</option>
                                    @foreach (var subject in Model.Subjects)
                                    {
                                        <option value="@subject.Id" selected="@(Model.SelectedSubjectId == subject.Id)">@subject.SubjectCode - @subject.SubjectName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Năm học</label>
                                <input type="text" class="form-control" name="academicYear" value="@Model.AcademicYear" placeholder="2025-2026" required />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Học kỳ</label>
                                <select class="form-select" name="semester" required>
                                    <option value="">-- Chọn kỳ --</option>
                                    <option value="1" selected="@(Model.Semester == 1)">Kỳ 1</option>
                                    <option value="2" selected="@(Model.Semester == 2)">Kỳ 2</option>
                                    <option value="3" selected="@(Model.Semester == 3)">Kỳ 3</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Loại điểm</label>
                                <select class="form-select" name="scoreType">
                                    @foreach (var type in Model.ScoreTypes)
                                    {
                                        <option value="@type.Value" selected="@(Model.ScoreType == type.Value)">@type.Label</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Mã sinh viên</label>
                                <input type="text" class="form-control" name="studentCode" placeholder="HE180001" required />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Điểm</label>
                                <input type="number" step="0.1" min="0" max="10" class="form-control" name="score" placeholder="8.5" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">Điểm chữ</label>
                                <input type="text" class="form-control" name="letterGrade" placeholder="A" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">Ghi chú</label>
                                <textarea class="form-control" name="notes" rows="2" placeholder="Ghi chú..."></textarea>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-primary w-100">Lưu điểm</button>
                            </div>
                        </form>
        </div>
    </div>
</div>


        </div>

        @if (Model.Result != null)
        {
            <div class="card radius-12">
                <div class="card-body">
                    <h6 class="mb-3">Kết quả import</h6>
                    <div class="row g-3">
                        <div class="col-md-3">Tổng dòng: <strong>@Model.Result.TotalRows</strong></div>
                        <div class="col-md-3">Thêm mới: <strong>@Model.Result.Imported</strong></div>
                        <div class="col-md-3">Cập nhật: <strong>@Model.Result.Updated</strong></div>
                        <div class="col-md-3">Bỏ qua: <strong>@Model.Result.Skipped</strong></div>
                    </div>
                    @if (Model.Result.Errors.Any())
                    {
                        <div class="mt-3">
                            <div class="fw-semibold mb-2">Lỗi:</div>
                            <ul class="mb-0">
                                @foreach (var err in Model.Result.Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
