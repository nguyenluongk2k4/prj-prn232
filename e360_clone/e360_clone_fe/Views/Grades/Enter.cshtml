@model e360_clone_fe.Models.ViewModels.GradeImportPageViewModel
@{
    ViewData["Title"] = "Enter Grades";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Nhập điểm</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item">Grades</li>
                        <li class="breadcrumb-item active" aria-current="page">Enter Grades</li>
                    </ul>
                </nav>
                <p class="text-secondary-light mt-2">Import điểm bằng file CSV hoặc XLSX.</p>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="ri-checkbox-circle-line"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="content-area p-24">
        <div class="card radius-12 mb-24">
            <div class="card-body">
                <form asp-action="Enter" method="post" enctype="multipart/form-data" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-12">
                        <label class="form-label">Ca thi</label>
                        <select class="form-select" name="examId" required>
                            <option value="">-- Chọn ca thi --</option>
                            @foreach (var exam in Model.Exams)
                            {
                                <option value="@exam.Id" selected="@(Model.SelectedExamId == exam.Id)">@exam.Display</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Loại điểm</label>
                        <select class="form-select" name="scoreType">
                            <option value="ProgressTest" selected="@(Model.ScoreType == "ProgressTest")">Progress Test</option>
                            <option value="Practical" selected="@(Model.ScoreType == "Practical")">Practical Exam</option>
                            <option value="Final" selected="@(Model.ScoreType == "Final")">Final Exam</option>
                            <option value="Lab" selected="@(Model.ScoreType == "Lab")">Lab</option>
                            <option value="Assignment" selected="@(Model.ScoreType == "Assignment")">Assignment</option>
                            <option value="Other" selected="@(Model.ScoreType == "Other")">Other</option>
                        </select>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">File điểm (CSV/XLSX)</label>
                        <input type="file" class="form-control" name="file" accept=".csv,.xlsx" required />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary-600">Import điểm</button>
                    </div>
                </form>

                <div class="mt-3 text-muted">
                    <div>Định dạng cột: <strong>StudentCode, Score, LetterGrade, Notes</strong></div>
                    <div>Ví dụ: <code>HE180001, 8.5, A, Good</code></div>
                </div>
            </div>
        </div>

        @if (Model.Result != null)
        {
            <div class="card radius-12">
                <div class="card-body">
                    <h6 class="mb-3">Kết quả import</h6>
                    <div class="row g-3">
                        <div class="col-md-3">Tổng dòng: <strong>@Model.Result.TotalRows</strong></div>
                        <div class="col-md-3">Thêm mới: <strong>@Model.Result.Imported</strong></div>
                        <div class="col-md-3">Cập nhật: <strong>@Model.Result.Updated</strong></div>
                        <div class="col-md-3">Bỏ qua: <strong>@Model.Result.Skipped</strong></div>
                    </div>
                    @if (Model.Result.Errors.Any())
                    {
                        <div class="mt-3">
                            <div class="fw-semibold mb-2">Lỗi:</div>
                            <ul class="mb-0">
                                @foreach (var err in Model.Result.Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
