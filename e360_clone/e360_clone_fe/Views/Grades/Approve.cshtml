@model e360_clone_fe.Models.ViewModels.GradeImportPageViewModel
@{
    ViewData["Title"] = "Approve Grades";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Công bố điểm</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item">Grades</li>
                        <li class="breadcrumb-item active" aria-current="page">Approve</li>
                    </ul>
                </nav>
                <p class="text-secondary-light mt-2">Admin công bố điểm, hệ thống sẽ gửi email cho sinh viên.</p>
            </div>
        </div>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3" role="alert">
            <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3" role="alert">
            <i class="ri-checkbox-circle-line"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table bordered-table mb-0">
                        <thead class="bg-neutral-100">
                            <tr>
                                <th>Ca thi</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Exams.Any())
                            {
                                @foreach (var exam in Model.Exams)
                                {
                                    <tr>
                                        <td>@exam.Display</td>
                                        <td>
                                            <form asp-action="Publish" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="examId" value="@exam.Id" />
                                                <button type="submit" class="btn btn-sm btn-success">Công bố</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" class="text-center py-4">
                                        <i class="ri-inbox-line text-muted" style="font-size: 48px;"></i>
                                        <p class="text-muted mt-2">Chưa có ca thi</p>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
