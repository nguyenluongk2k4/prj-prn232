@model e360_clone_fe.Models.ViewModels.SubjectDetailsViewModel
@{
    ViewData["Title"] = "Chi tiết môn học";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div>
                <h1 class="text-2xl fw-bold mb-2 text-primary-light">Chi tiết môn học</h1>
                <nav aria-label="breadcrumb">
                    <ul class="breadcrumb mb-0">
                        <li class="breadcrumb-item"><a href="/">Trang chủ</a></li>
                        <li class="breadcrumb-item"><a asp-action="Index">Môn học</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                    </ul>
                </nav>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Subject.Id" class="btn btn-primary-600">
                    <i class="ri-edit-2-line"></i> Sửa
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="ri-arrow-left-line"></i> Quay lại
                </a>
            </div>
        </div>
    </div>

    <div class="content-area p-24">
        <div class="card radius-12">
            <div class="card-body">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success mb-16" role="alert">
                        <i class="ri-check-line"></i> @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger mb-16" role="alert">
                        <i class="ri-error-warning-line"></i> @TempData["ErrorMessage"]
                    </div>
                }

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <h6 class="fw-bold mb-3">Thông tin cơ bản</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Mã môn</span>
                                <span class="fw-medium">@Model.Subject.SubjectCode</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Tên môn</span>
                                <span class="fw-medium">@Model.Subject.SubjectName</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Số tín chỉ</span>
                                <span class="fw-medium">@Model.Subject.Credits</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Loại môn</span>
                                <span class="fw-medium">@Model.Subject.SubjectType</span>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded-3 p-3 h-100">
                            <h6 class="fw-bold mb-3">Thông tin học phần</h6>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Lý thuyết</span>
                                <span class="fw-medium">@Model.Subject.TheoryHours giờ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Thực hành</span>
                                <span class="fw-medium">@Model.Subject.PracticeHours giờ</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Bộ môn</span>
                                <span class="fw-medium">@Model.Subject.Department</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2">
                                <span class="text-secondary-light">Trạng thái</span>
                                <span class="fw-medium">@Model.Subject.Status</span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 border rounded-3 p-3">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h6 class="fw-bold mb-0">Gán lớp giảng dạy</h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#createClassModal">
                            + Tạo lớp mới
                        </button>
                    </div>
                    @if (Model.AvailableClasses.Count == 0)
                    {
                        <div class="alert alert-warning mb-16" role="alert">
                            Không còn lớp trống để gán cho môn này.
                        </div>
                    }
                    <form asp-action="AddClass" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AddAssignment.SubjectId" value="@Model.Subject.Id" />
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Lớp học</label>
                                <select class="form-control form-select" name="AddAssignment.ClassId">
                                    <option value="">Chọn lớp</option>
                                    @foreach (var cls in Model.AvailableClasses)
                                    {
                                        <option value="@cls.Id">@cls.ClassCode - @cls.ClassName</option>
                                    }
                                </select>
                                <div class="text-xs text-muted mt-6">
                                    Chưa có lớp? <a asp-controller="Classes" asp-action="Create">Tạo lớp mới</a>
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Giảng viên</label>
                                <select class="form-control form-select" name="AddAssignment.LecturerId">
                                    <option value="">Chọn giảng viên</option>
                                    @foreach (var lec in Model.Lecturers)
                                    {
                                        <option value="@lec.Id">@lec.EmployeeCode - @lec.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary-600">
                                    <i class="ri-add-line"></i> Gán lớp
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="mt-4 border rounded-3 p-3">
                    <h6 class="fw-bold mb-3">Thêm sinh viên vào môn</h6>
                    @if (Model.AssignedClasses.Count == 0)
                    {
                        <div class="alert alert-warning mb-16" role="alert">
                            Môn này chưa có lớp được phân công dạy. Vui lòng gán lớp trước.
                        </div>
                    }
                    <form asp-action="AddStudent" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="AddRequest.SubjectId" value="@Model.Subject.Id" />
                        <div class="row g-3 align-items-end">
                            <div class="col-md-4">
                                <label class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Lớp học</label>
                                <select class="form-control form-select" id="classSelect" name="AddRequest.ClassId">
                                    <option value="">Chọn lớp</option>
                                    @foreach (var cls in Model.AssignedClasses)
                                    {
                                        <option value="@cls.Id">@cls.ClassCode - @cls.ClassName</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-5">
                                <label class="text-sm fw-semibold text-primary-light d-inline-block mb-8">Sinh viên (chưa thuộc lớp)</label>
                                <div id="studentList" class="form-control" style="min-height: 140px; max-height: 180px; overflow:auto;"></div>
                                <div class="text-xs text-muted mt-6">Chọn nhiều sinh viên để chuyển vào lớp và thêm vào môn.</div>
                            </div>
                            <div class="col-md-3">
                                <button type="submit" class="btn btn-primary-600">
                                    <i class="ri-user-add-line"></i> Thêm sinh viên
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="mt-4">
                    <form asp-action="Delete" asp-route-id="@Model.Subject.Id" method="post"
                          onsubmit="return confirm('Bạn có chắc muốn xóa môn học này?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">
                            <i class="ri-delete-bin-6-line"></i> Xóa môn học
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createClassModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tạo lớp mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="CreateClassInline" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Mã lớp</label>
                            <input class="form-control" name="NewClass.ClassCode" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên lớp</label>
                            <input class="form-control" name="NewClass.ClassName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Ngành</label>
                            <select class="form-control form-select" name="NewClass.MajorId">
                                <option value="">Chọn ngành</option>
                                @foreach (var major in Model.Majors)
                                {
                                    <option value="@major.Id">@major.MajorCode - @major.MajorName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Trạng thái</label>
                            <select class="form-control form-select" name="NewClass.Status">
                                <option value="Active">Active</option>
                                <option value="Graduated">Graduated</option>
                                <option value="Disbanded">Disbanded</option>
                            </select>
                        </div>
                        <input type="hidden" name="NewClass.CourseId" value="0" />
                        <input type="hidden" name="NewClass.AcademicYear" value="" />
                        <input type="hidden" name="NewClass.Semester" value="0" />
                        <input type="hidden" name="NewClass.StudentCount" value="0" />
                        <input type="hidden" name="NewClass.Cohort" value="0" />
                        <input type="hidden" name="NewClass.CohortYear" value="0" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary-600">Tạo lớp</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const apiBase = window.APP_CONFIG?.API_BASE_URL || '/api';
            const classSelect = document.getElementById('classSelect');
            const studentList = document.getElementById('studentList');

            function resetStudents() {
                studentList.innerHTML = '<div class=\"text-muted\">Chọn lớp để tải sinh viên</div>';
            }

            async function loadStudentsByClass() {
                const classId = classSelect.value;
                if (!classId) {
                    resetStudents();
                    return;
                }
                const url = `${apiBase}/students/not-in-class?pageNumber=1&pageSize=1000&classId=${encodeURIComponent(classId)}`;
                const res = await fetch(url, { headers: { 'Accept': 'application/json' } });
                const json = await res.json();
                const students = Array.isArray(json.data) ? json.data : [];
                studentList.innerHTML = '';
                if (students.length === 0) {
                    studentList.innerHTML = '<div class=\"text-muted\">Không có sinh viên phù hợp</div>';
                    return;
                }
                students.forEach(s => {
                    const wrapper = document.createElement('div');
                    wrapper.className = 'form-check';
                    wrapper.innerHTML = `
                        <input class=\"form-check-input\" type=\"checkbox\" name=\"AddRequest.StudentIds\" value=\"${s.id}\" id=\"stu_${s.id}\">
                        <label class=\"form-check-label\" for=\"stu_${s.id}\">${s.studentCode} - ${s.fullName}</label>
                    `;
                    studentList.appendChild(wrapper);
                });
            }

            classSelect?.addEventListener('change', loadStudentsByClass);
            resetStudents();
        })();
    </script>
}
