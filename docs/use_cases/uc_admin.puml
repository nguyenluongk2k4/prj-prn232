@startuml
' 2.2.1 UCs for Admin / SuperAdmin
left to right direction
skinparam packageStyle rectangle
skinparam usecase {
    BackgroundColor White
    BorderColor Black
}
skinparam actor {
    BackgroundColor White
    BorderColor Black
}

actor "Admin" as admin

rectangle "e360 Exam Management System" {

    usecase "Login" as UC_LOGIN
    usecase "Reset Password" as UC_RESET
    usecase "Logout" as UC_LOGOUT

    usecase "View Dashboard" as UC_DASHBOARD

    usecase "Manage Accounts" as UC_ACCOUNTS
    usecase "Create Account" as UC_CREATE_ACC
    usecase "Update Account" as UC_UPDATE_ACC
    usecase "Lock / Unlock Account" as UC_LOCK_ACC

    usecase "Manage Students" as UC_STUDENTS
    usecase "Create Student" as UC_CREATE_STU
    usecase "Update Student" as UC_UPDATE_STU
    usecase "Delete Student" as UC_DELETE_STU

    usecase "Manage Lecturers" as UC_LECTURERS
    usecase "Create Lecturer" as UC_CREATE_LEC
    usecase "Update Lecturer" as UC_UPDATE_LEC
    usecase "Delete Lecturer" as UC_DELETE_LEC

    usecase "Manage Subjects" as UC_SUBJECTS
    usecase "Manage Classes" as UC_CLASSES
    usecase "Manage Exam Rooms" as UC_ROOMS

    usecase "View All Exam Schedules" as UC_EXAMS
    usecase "View Proctor Assignments" as UC_PROCTOR
    usecase "View Grade Results" as UC_GRADES

    usecase "View Reports & Statistics" as UC_REPORTS
}

admin --> UC_LOGIN
admin --> UC_LOGOUT
admin --> UC_DASHBOARD
admin --> UC_ACCOUNTS
admin --> UC_STUDENTS
admin --> UC_LECTURERS
admin --> UC_SUBJECTS
admin --> UC_CLASSES
admin --> UC_ROOMS
admin --> UC_EXAMS
admin --> UC_PROCTOR
admin --> UC_GRADES
admin --> UC_REPORTS

UC_LOGIN <.. UC_RESET : <<extend>>

UC_ACCOUNTS <.. UC_CREATE_ACC : <<extend>>
UC_ACCOUNTS <.. UC_UPDATE_ACC : <<extend>>
UC_ACCOUNTS <.. UC_LOCK_ACC : <<extend>>

UC_STUDENTS <.. UC_CREATE_STU : <<extend>>
UC_STUDENTS <.. UC_UPDATE_STU : <<extend>>
UC_STUDENTS <.. UC_DELETE_STU : <<extend>>

UC_LECTURERS <.. UC_CREATE_LEC : <<extend>>
UC_LECTURERS <.. UC_UPDATE_LEC : <<extend>>
UC_LECTURERS <.. UC_DELETE_LEC : <<extend>>

@enduml
