@model e360_clone_fe.Models.ViewModels.StudentViewModel
@{
    ViewData["Title"] = "Chi tiết sinh viên";
    var statusClass = Model.Status switch
    {
        "Active" => "bg-success-100 text-success-600",
        "Inactive" => "bg-warning-100 text-warning-600",
        "Graduated" => "bg-info-100 text-info-600",
        _ => "bg-neutral-100 text-secondary-light"
    };
    var classInfo = Model.Class != null
        ? $"{Model.Class.ClassCode} - {Model.Class.ClassName}"
        : $"Lớp {Model.ClassId}";
    var avatarSrc = !string.IsNullOrWhiteSpace(Model.AvatarUrl)
        ? Model.AvatarUrl
        : "/assets/images/thumbs/student-details-img.png";
}

<div class="main-content__wrapper">
    <div class="breadcrumb-area py-20 px-24 bg-neutral-50">
        <div>
            <h1 class="fw-semibold mb-4 h6 text-primary-light">Chi tiết sinh viên</h1>
            <div>
                <a href="/" class="text-secondary-light hover-text-primary hover-underline">Dashboard</a>
                <a asp-action="Index" class="text-secondary-light hover-text-primary hover-underline"> / Sinh viên</a>
                <span class="text-secondary-light">/ Chi tiết</span>
            </div>
        </div>
    </div>

    <div class="content-area p-24">
        <div class="d-flex justify-content-end gap-8 mb-24">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="btn btn-primary-600 d-flex align-items-center gap-6">
                <span class="d-flex text-md"><i class="ri-edit-line"></i></span>
                Sửa
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-6">
                <span class="d-flex text-md"><i class="ri-arrow-left-line"></i></span>
                Quay lại
            </a>
        </div>

            <div class="card h-100">
            <div class="card-body p-24">
                <div class="d-flex gap-32 flex-md-row flex-column">
                    <div class="max-w-300-px w-100 text-center">
                        <figure class="mb-24 w-120-px h-120-px mx-auto rounded-circle overflow-hidden">
                            <img src="@avatarSrc"
                                 alt="Student Image"
                                 class="w-100 h-100 object-fit-cover">
                        </figure>
                        <h2 class="h6 text-primary-light mb-16 fw-semibold">@Model.FullName</h2>
                        <p class="mb-0">Mã sinh viên:
                            <span class="text-primary-600 fw-semibold">@Model.StudentCode</span>
                        </p>
                        <p class="mb-0">ID:
                            <span class="text-primary-light fw-semibold">@Model.Id</span>
                        </p>
                        <div class="mt-32 d-flex gap-16 w-100">
                            <form asp-action="Delete" method="post" class="flex-grow-1">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <button type="submit"
                                        class="btn border fw-medium border-danger-600 bg-hover-danger-200 text-danger-600 text-md d-flex justify-content-center align-items-center gap-8 w-100 px-12 py-8 radius-8">
                                    <span class="d-flex text-lg"><i class="ri-delete-bin-2-line"></i></span>
                                    Xóa
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@Model.Id"
                               class="btn btn-primary-600 border fw-medium border-primary-600 text-md d-flex justify-content-center align-items-center gap-8 flex-grow-1 px-12 py-8 radius-8">
                                <span class="d-flex text-lg"><i class="ri-edit-line"></i></span>
                                Sửa
                            </a>
                        </div>
                    </div>
                    <div class="d-none d-md-flex">
                        <span class="h-100 w-1-px bg-neutral-200"></span>
                    </div>
                    <div class="flex-grow-1">
                        <div class="pb-16 border-bottom d-flex align-items-center justify-content-between gap-20">
                            <h3 class="h6 text-primary-light text-lg mb-0 fw-semibold">Thông tin cá nhân</h3>
                            <span class="@statusClass px-16 py-4 radius-4 fw-medium text-sm">@Model.StatusText</span>
                        </div>
                        <div class="mt-16 d-flex flex-column gap-8">
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Lớp</span>
                                <span class="fw-normal text-sm text-secondary-light">: @classInfo</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Khóa</span>
                                <span class="fw-normal text-sm text-secondary-light">: @(Model.Class?.Cohort > 0 ? $"K{Model.Class.Cohort}" : "N/A")</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Năm khóa</span>
                                <span class="fw-normal text-sm text-secondary-light">: @(Model.Class?.CohortYear > 0 ? Model.Class.CohortYear.ToString() : "N/A")</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Giảng viên</span>
                                <span class="fw-normal text-sm text-secondary-light">: Chưa liên kết</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Giới tính</span>
                                <span class="fw-normal text-sm text-secondary-light">: @Model.GenderText</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Ngày sinh</span>
                                <span class="fw-normal text-sm text-secondary-light">: @Model.DateOfBirth.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Năm học</span>
                                <span class="fw-normal text-sm text-secondary-light">: @(Model.Class?.AcademicYear ?? "N/A")</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Điện thoại</span>
                                <span class="fw-normal text-sm text-primary-600">: @Model.PhoneNumber</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Email</span>
                                <span class="fw-normal text-sm text-primary-600">: @Model.Email</span>
                            </div>
                            <div class="d-flex gap-4">
                                <span class="fw-semibold text-sm text-primary-light w-110-px">Địa chỉ</span>
                                <span class="fw-normal text-sm text-secondary-light">: @Model.Address</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>




